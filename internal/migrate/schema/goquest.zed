/**
 * goquest SpiceDB schema
 *
 * Hierarchy: user → workspace → project → ticket
 * Visibility modes:
 *   project    - all project members can view
 *   restricted - only explicitly listed users can view
 */

definition user {}

definition workspace {
  relation owner:  user
  relation admin:  user
  relation member: user
  relation viewer: user

  permission can_view        = owner + admin + member + viewer
  permission can_manage      = owner + admin
  permission can_admin       = owner
  permission contract_approve = owner + admin
}

definition project {
  relation workspace: workspace

  // Direct project roles
  relation admin:  user
  relation member: user
  relation viewer: user
  // editor: works tickets (status, assignee, dates, priority, title/description,
  // sub-tickets, relations) without the management powers of admin.
  relation editor: user

  // Inherited from workspace
  permission can_view   = admin + editor + member + viewer
                        + workspace->can_view
  permission can_manage = admin + workspace->can_manage
  permission can_edit   = editor + can_manage
  permission can_admin  = workspace->can_admin
}

definition ticket {
  relation project:   project
  relation requester: user
  relation assignee:  user

  // Explicit viewers for restricted visibility
  relation restricted_viewer: user

  // project visibility: all project members can view
  permission can_view_project    = project->can_view + requester + assignee

  // restricted visibility: only requester, assignee, and explicit viewers
  permission can_view_restricted = requester + assignee + restricted_viewer

  // Combined; the handler picks which to check based on ticket.visibility
  permission can_manage = project->can_manage + requester

  // Day-to-day work on a ticket: project editors plus everyone who can manage.
  // Deliberately NOT including assignee (spec Q2).
  permission can_work = project->can_edit + can_manage
}
